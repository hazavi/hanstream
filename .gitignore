!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/tests/
/__tests__/
**/*.test.*
**/*.spec.*
/playwright-report/
/test-results/
/coverage

# next.js
/.next/
/.next-dev/
/.next-dev-webpack/
/.next-dev-turbo/
