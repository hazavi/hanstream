# Copy this file to .env.local and enter the private HTTPS source origins.
# Use origin URLs only (no path, query, credentials, or port).
# Keep these server-only; do not use NEXT_PUBLIC_ or next.config.env.
STREAM_SOURCE_URL=
METADATA_SOURCE_URL=
EDITORIAL_SOURCE_URL=
DETAILS_SOURCE_URL=
CATALOG_SOURCE_URL=
MEDIA_SOURCE_URL=
ARTWORK_SOURCE_URL=

# Backend only: exact frontend origins, separated by commas. No trailing slash.
FRONTEND_ORIGINS=https://hanstream-backend.onrender.com
SITE_URL=https://hanstream-backend.onrender.com

# Public Pages build configuration. Set API_BASE_URL in GitHub repository variables.
# NEXT_PUBLIC_API_BASE_URL and PAGES_BASE_PATH are supplied by the Pages workflow.

# Optional public broadcaster catalog fallback
REFERENCE_SOURCE_URL=

# Optional comma-separated public HTML search URL templates containing {query}
POSTER_SEARCH_URLS=

# Optional private Redis-compatible cache. Use rediss:// for TLS.
# Leave empty to retain the existing process-local caches.
CACHE_URL=
# Optional exact HTTPS image CDN origins permitted for server resizing.
IMAGE_ORIGINS=

# Optional private diagnostic access token (at least 32 random characters).
DIAGNOSTICS_TOKEN=
# Trust a client-IP header only if your reverse proxy overwrites it.
# Otherwise requests share conservative per-process category limits.
TRUST_PROXY=0
RATE_LIMIT_IP_HEADER=

# Public backend origin for desktop builds; private readers stay on the backend.
DESKTOP_API_BASE_URL=
# Signed releases are disabled until CI certificate and updater secrets exist.
DESKTOP_SIGNED_UPDATES=0
DESKTOP_UPDATER_PUBLIC_KEY=
DESKTOP_UPDATER_ENDPOINT=
DESKTOP_DOWNLOAD_BASE_URL=
