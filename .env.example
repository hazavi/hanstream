# Copy this file to .env.local and enter the private HTTPS source origins.
# Use origin URLs only (no path, query, credentials, or port).
# Keep these server-only; do not use NEXT_PUBLIC_ or next.config.env.
STREAM_SOURCE_URL=
# Server-side exclusion of exact HTTPS player origins reported unsafe or unavailable.
PLAYBACK_EXCLUDED_ORIGINS=
METADATA_SOURCE_URL=
EDITORIAL_SOURCE_URL=
DETAILS_SOURCE_URL=
CATALOG_SOURCE_URL=
MEDIA_SOURCE_URL=
ARTWORK_SOURCE_URL=

# Website: exact extra frontend origins, separated by commas. No trailing slash.
# Same-origin requests and https://tauri.localhost are already permitted.
FRONTEND_ORIGINS=
SITE_URL=
# Vercel: web. Separate Docker worker: reader. Unset: full local/Render app.
HANSTREAM_ROLE=
# Website and worker must share a reachable TLS CACHE_URL and namespace.
READER_NAMESPACE=hanstream
# Private-reader transport: use the existing full reader host and its private cache.
# Set both on the website; set the same random secret on the reader host.
READER_GATEWAY_ORIGIN=
READER_GATEWAY_SECRET=
# Optional demand wake of the reader's own /health endpoint.
READER_WAKE_ORIGIN=
# Exact public player origins for building the optional browser extension.
PLAYER_ORIGINS=

# Public Pages build configuration. Set API_BASE_URL in GitHub repository variables.
# NEXT_PUBLIC_API_BASE_URL and PAGES_BASE_PATH are supplied by the Pages workflow.

# Optional public broadcaster catalog fallback
REFERENCE_SOURCE_URL=
# Optional independent public HTML catalogs for details, posters and episode guides.
GUIDE_SOURCE_URL=
COLLECTION_SOURCE_URL=
# Optional comma-separated public HTML playback catalog origins. Players still
# require an exact approved origin, and title/year/episode must match.
PLAYBACK_FALLBACK_URLS=

# Optional comma-separated public HTML search URL templates containing {query}
POSTER_SEARCH_URLS=

# Required shared Redis-compatible TLS cache for Vercel + separate reader.
# Optional for the full local/Render application.
CACHE_URL=
# Render only: exact private Key Value hostname, in the same workspace and region.
# Allows redis:// on port 6379 only when RENDER=true; public caches still require TLS.
CACHE_PRIVATE_HOST=
# Optional exact HTTPS image CDN origins permitted for server resizing.
IMAGE_ORIGINS=

# Optional private diagnostic access token (at least 32 random characters).
DIAGNOSTICS_TOKEN=
# Trust a client-IP header only if your reverse proxy overwrites it.
# Otherwise requests share conservative per-process category limits.
TRUST_PROXY=0
RATE_LIMIT_IP_HEADER=

# Public backend origin for desktop builds; private readers stay on the backend.
DESKTOP_API_BASE_URL=
# Exact public HTTPS player origins, including approved navigation redirect origins.
DESKTOP_MEDIA_ORIGINS=
# Signed releases are disabled until CI certificate and updater secrets exist.
DESKTOP_SIGNED_UPDATES=0
DESKTOP_UPDATER_PUBLIC_KEY=
DESKTOP_UPDATER_ENDPOINT=
DESKTOP_DOWNLOAD_BASE_URL=
